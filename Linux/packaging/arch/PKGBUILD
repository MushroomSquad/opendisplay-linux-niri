pkgname=opendisplay-linux-git
pkgver=1.14.0.r0.g0173617
pkgrel=4
pkgdesc="Use an iOS device as a KDE, Hyprland or niri Wayland display"
arch=('x86_64')
url="https://github.com/MushroomSquad/opendisplay-linux-niri"
license=('GPL-3.0-only')
depends=('qt6-base' 'qt6-declarative' 'qt6-wayland' 'kirigami' 'pipewire' 'avahi'
         'libusbmuxd' 'usbmuxd' 'ffmpeg' 'libkscreen>=6.6' 'wayland'
         'xdg-desktop-portal' 'xdg-desktop-portal-kde')
makedepends=('cmake' 'git')
optdepends=('libva-mesa-driver: VA-API support for AMD GPUs'
            'intel-media-driver: VA-API support for modern Intel GPUs'
            'nvidia-utils: NVENC support for NVIDIA GPUs'
            'hyprland: Hyprland compositor backend'
            'xdg-desktop-portal-hyprland: Hyprland screen-cast portal'
            'niri: niri compositor backend (mirror mode)')
provides=('opendisplay-linux')
conflicts=('opendisplay-linux')
_giturl="https://github.com/MushroomSquad/opendisplay-linux-niri.git"
_branch="main"
source=("opendisplay::git+${_giturl}#branch=${_branch}")
sha256sums=('SKIP')

pkgver() {
  cd opendisplay
  git describe --long --tags --always | sed 's/^v//;s/-/.r/;s/-/./'
}

build() {
  cmake -S opendisplay/Linux -B build \
    -DCMAKE_BUILD_TYPE=Release \
    -DCMAKE_INSTALL_PREFIX=/usr \
    -DOPENDISPLAY_BUILD_GUI=ON \
    -DBUILD_TESTING=ON
  cmake --build build --parallel
}

check() {
  ctest --test-dir build --output-on-failure
}

package() {
  DESTDIR="$pkgdir" cmake --install build
  install -Dm644 opendisplay/Linux/README.md \
    "$pkgdir/usr/share/doc/$pkgname/README.md"
}
